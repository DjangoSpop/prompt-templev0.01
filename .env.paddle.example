# Paddle (payments) - set these in Vercel > Project > Settings > Environment Variables, never commit real values.
# The client-side token comes from Paddle > Developer tools > Authentication > Client-side tokens.
NEXT_PUBLIC_PADDLE_ENV=production          # optional; defaults to production. Set to sandbox only with a test_ token
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=           # live_... for production, test_... for sandbox
